# Copy to .env for local development. Never commit real secrets.

# PostgreSQL
HOOKRELAY_DB_NAME=hookrelay
HOOKRELAY_DB_USER=hookrelay
HOOKRELAY_DB_PASSWORD=change-me-local-only
# Host port 5433 avoids clashing with a local PostgreSQL on 5432.
HOOKRELAY_DB_PORT=5433
HOOKRELAY_DB_URL=jdbc:postgresql://localhost:5433/hookrelay

# Redis
HOOKRELAY_REDIS_HOST=localhost
HOOKRELAY_REDIS_PORT=6379

# Kafka (host-mapped EXTERNAL listener)
HOOKRELAY_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
HOOKRELAY_KAFKA_PORT=29092

# Application ports
HOOKRELAY_INGESTION_PORT=8080
HOOKRELAY_DELIVERY_PORT=8081
HOOKRELAY_ADMIN_PORT=8082

# Observability
HOOKRELAY_PROMETHEUS_PORT=9090
HOOKRELAY_GRAFANA_PORT=3000
HOOKRELAY_GRAFANA_USER=admin
HOOKRELAY_GRAFANA_PASSWORD=change-me-local-only
HOOKRELAY_OTEL_GRPC_PORT=4317
HOOKRELAY_OTEL_HTTP_PORT=4318
HOOKRELAY_GRAPHIQL_ENABLED=true

# Endpoint secret encryption key (AES-256, 32 bytes base64). Generate for local use only.
# Example generation: openssl rand -base64 32
HOOKRELAY_ENDPOINT_SECRET_KEY=REPLACE_WITH_LOCAL_BASE64_KEY
